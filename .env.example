# ─────────────────────────────────────────────────────────────────────────────
# NCK Agro — environment variables
#
# Copy to .env.local for development. In production set these in
# Netlify → Project configuration → Environment variables (never commit real values).
# Check what is set (names only, values never printed):
#   npm run check-env            development rules
#   npm run check-env -- --prod  production rules
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the site (https in production). Used for origin checks.
APP_URL=http://localhost:3000
# Optional: development | test | staging | production (defaults from NODE_ENV).
# Use "staging" for a preview deployment that should accept Razorpay TEST keys.
# APP_ENV=

# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# Supabase → Connect → "Transaction pooler" URI (port 6543). Server-only.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres
# DATABASE_POOL_MAX=3

# ── Supabase Storage (product / brand / banner images) ───────────────────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Supabase → Project Settings → API Keys → Secret key (sb_secret_…). Server-only.
SUPABASE_SECRET_KEY=
# STORAGE_BUCKET=product-images

# ── Login security ───────────────────────────────────────────────────────────
# 32+ random characters. Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ── Login codes by SMS ───────────────────────────────────────────────────────
# console = development only (code printed in the terminal). Production: msg91 or twilio.
OTP_PROVIDER=console
# MSG91 (India; needs a DLT-approved OTP template)
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# Twilio Verify
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# ── Payments (Razorpay) ──────────────────────────────────────────────────────
# Dashboard → Account & Settings → API Keys. rzp_test_… for testing, rzp_live_… in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → secret you chose for https://YOUR_DOMAIN/api/payment/webhook
RAZORPAY_WEBHOOK_SECRET=

# ── Scheduled jobs ───────────────────────────────────────────────────────────
# 16+ random characters; used by the hourly cleanup job (netlify/functions/expire-orders.mts).
CRON_SECRET=

# ── Rate limiting (recommended in production) ────────────────────────────────
# Upstash Redis → REST API. Without it, limits are kept per server instance.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Optional ─────────────────────────────────────────────────────────────────
# Fallback support WhatsApp number (10 digits) if none is set in Admin → Settings.
# NEXT_PUBLIC_WHATSAPP_NUMBER=
# LOG_LEVEL=info
